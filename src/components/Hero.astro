---
type Props = {
  name: string;
  eyebrow: string;
  subtitle: string;
  summary: string;
  email: string;
  contactLabel: string;
};

const { name, eyebrow, subtitle, summary, email, contactLabel } = Astro.props;
---

<section id="top" class="relative flex min-h-[calc(100svh-10rem)] w-full items-center justify-center px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
  <div class="relative mx-auto w-full max-w-4xl">
    <div class="glass-panel rounded-[2rem] p-6 sm:p-10 lg:p-14 animate-float">
      <div class="space-y-6 text-center">
        <p data-i18n="heroEyebrow" class="text-sm uppercase tracking-[0.45em] text-slate-300/70">{eyebrow}</p>
        <h1 class="font-display text-5xl font-extrabold tracking-[-0.05em] text-white sm:text-7xl lg:text-[5.5rem]">
          {name}
        </h1>
        <p data-i18n="subtitle" class="mx-auto max-w-2xl text-lg leading-8 text-slate-200/85 sm:text-xl">
          {subtitle}
        </p>
        <p data-i18n="summary" class="mx-auto max-w-2xl text-base leading-7 text-slate-300/80 sm:text-lg">
          {summary}
        </p>
        <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
          <a
            href={`mailto:${email}`}
            data-i18n-email={email}
            class="glass-pill rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
          >
            {contactLabel}: {email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
