---
import type { Locale, SiteLink } from "../data/site";

type Props = {
  links: Array<SiteLink & { text: string }>;
  copyright: string;
  label: string;
  languageLabel: string;
  currentLocale: Locale;
  languages: Record<Locale, string>;
};

const { links, copyright, label, languageLabel, currentLocale, languages } = Astro.props;
const localeEntries = Object.entries(languages) as Array<[Locale, string]>;
---

<footer class="relative z-20 mt-auto px-4 pb-0 sm:px-6 lg:px-10">
  <div class="glass-panel mx-auto flex max-w-6xl translate-y-5 flex-col gap-4 rounded-[1.75rem] px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
    <p data-i18n="copyright" class="text-sm text-slate-300/80">{copyright}</p>
    <div class="flex flex-wrap items-center justify-end gap-3 text-sm text-slate-200/80">
      <div class="flex flex-wrap items-center gap-3">
        <span data-i18n="footerLabel" class="uppercase tracking-[0.24em] text-slate-400/80">{label}</span>
        {
          links.map((link, index) => (
            <a
              href={link.href}
              data-i18n-link-group="footer"
              data-i18n-link-index={String(index)}
              class="rounded-full border border-transparent px-3 py-2 transition hover:border-white/10 hover:bg-white/10 hover:text-white"
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <div class="h-6 w-px bg-white/10"></div>
      <div class="flex items-center gap-2">
        <span data-i18n="languageLabel" class="uppercase tracking-[0.24em] text-slate-400/80">{languageLabel}</span>
        {
          localeEntries.map(([locale, shortLabel]) => (
            <button
              type="button"
              data-lang-button={locale}
              aria-pressed={locale === currentLocale ? "true" : "false"}
              class:list={[
                "rounded-full border px-3 py-2 text-xs font-semibold uppercase tracking-[0.24em] transition backdrop-blur-xl",
                locale === currentLocale
                  ? "border-white/20 bg-white/16 text-white"
                  : "border-white/10 bg-white/5 text-slate-300 hover:border-white/20 hover:bg-white/10 hover:text-white"
              ]}
            >
              {shortLabel}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</footer>
