---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Starfield from "../components/Starfield.astro";
import { siteConfig } from "../data/site";

const locale = siteConfig.defaultLocale;
const content = siteConfig.locales[locale];
const navLinks = siteConfig.nav.links.map((link) => ({
  ...link,
  text: link.label[locale]
}));
const footerLinks = siteConfig.footer.links.map((link) => ({
  ...link,
  text: link.label[locale]
}));
---

<BaseLayout title={content.metaTitle} description={content.metaDescription} lang={locale}>
  <Starfield />
  <div class="relative flex min-h-screen flex-col overflow-hidden">
    <Navbar links={navLinks} label={content.navLabel} />
    <main class="flex flex-1 items-center">
      <Hero
        name={siteConfig.brand.name}
        eyebrow={content.heroEyebrow}
        subtitle={content.subtitle}
        summary={content.summary}
        email={siteConfig.contact.email}
        contactLabel={content.contactLabel}
      />
    </main>
    <Footer
      links={footerLinks}
      copyright={content.copyright}
      label={content.footerLabel}
      languageLabel={content.languageLabel}
      currentLocale={locale}
      languages={content.languages}
    />
  </div>

  <script is:inline id="site-config" type="application/json" set:html={JSON.stringify(siteConfig)}></script>
  <script is:inline>
    const configElement = document.getElementById("site-config");
    const siteConfig = configElement ? JSON.parse(configElement.textContent || "{}") : null;

    if (siteConfig) {
      const defaultLocale = siteConfig.defaultLocale || "en";
      const storageKey = "preferred-locale";

      const getLocale = () => {
        const stored = window.localStorage.getItem(storageKey);
        if (stored && siteConfig.locales[stored]) {
          return stored;
        }
        return defaultLocale;
      };

      const updateLinkGroup = (group, locale) => {
        const source = siteConfig[group]?.links || [];
        document.querySelectorAll(`[data-i18n-link-group="${group}"]`).forEach((element) => {
          const index = Number(element.getAttribute("data-i18n-link-index"));
          if (source[index]?.label?.[locale]) {
            element.textContent = source[index].label[locale];
          }
        });
      };

      const updateAriaLabels = (locale) => {
        const content = siteConfig.locales[locale];
        document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
          const key = element.getAttribute("data-i18n-aria-label");
          if (key && content[key] !== undefined) {
            element.setAttribute("aria-label", content[key]);
          }
        });
      };

      const setPressedState = (locale) => {
        document.querySelectorAll("[data-lang-button]").forEach((button) => {
          const isActive = button.getAttribute("data-lang-button") === locale;
          button.setAttribute("aria-pressed", String(isActive));
          button.classList.toggle("border-white/20", isActive);
          button.classList.toggle("bg-white/16", isActive);
          button.classList.toggle("text-white", isActive);
          button.classList.toggle("border-white/10", !isActive);
          button.classList.toggle("bg-white/5", !isActive);
          button.classList.toggle("text-slate-300", !isActive);
        });
      };

      const applyLocale = (locale) => {
        const content = siteConfig.locales[locale];
        if (!content) {
          return;
        }

        document.documentElement.lang = locale;
        document.title = content.metaTitle;

        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
          metaDescription.setAttribute("content", content.metaDescription);
        }

        document.querySelectorAll("[data-i18n]").forEach((element) => {
          const key = element.getAttribute("data-i18n");
          if (key && content[key] !== undefined) {
            element.textContent = content[key];
          }
        });

        document.querySelectorAll("[data-i18n-email]").forEach((element) => {
          const email = element.getAttribute("data-i18n-email");
          if (email) {
            element.textContent = `${content.contactLabel}: ${email}`;
          }
        });

        updateAriaLabels(locale);
        updateLinkGroup("nav", locale);
        updateLinkGroup("footer", locale);
        setPressedState(locale);
      };

      applyLocale(getLocale());

      document.querySelectorAll("[data-lang-button]").forEach((button) => {
        button.addEventListener("click", () => {
          const locale = button.getAttribute("data-lang-button");
          if (locale && siteConfig.locales[locale]) {
            window.localStorage.setItem(storageKey, locale);
            applyLocale(locale);
          }
        });
      });
    }
  </script>
</BaseLayout>
